{
  "name": "contractix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "dev": "tsx scripts/dev.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web --passWithNoTests",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "compose:up": "docker compose up -d --wait",
    "compose:down": "docker compose down",
    "db:generate": "pnpm --filter @contractix/api db:generate",
    "db:migrate": "pnpm --filter @contractix/api db:migrate",
    "corpus:generate": "tsx scripts/generate-corpus.ts",
    "seed:demo": "pnpm --filter @contractix/api seed:demo",
    "demo:extract": "pnpm --filter @contractix/api demo:extract",
    "eval:retrieval": "pnpm --filter @contractix/eval retrieval",
    "eval:extraction": "pnpm --filter @contractix/eval extraction",
    "eval:rules": "pnpm --filter @contractix/eval rules"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "docx": "^9.7.1",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.1",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
