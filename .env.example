# Copy to .env and adjust. Empty provider keys => keyless mode:
# deterministic fake embeddings + passthrough reranker (tests/CI run fully offline).

# --- runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- infra ---
DATABASE_URL=postgres://contractix:contractix@localhost:5433/contractix
REDIS_URL=redis://localhost:6380
STORAGE_DIR=./data/files

# --- sessions (FR-6.2 anonymous demo tenant) ---
# Signs the anonymous session cookie. Leave empty in dev and a public default is
# used; production refuses to boot with it, since anyone could then mint a
# cookie for any tenant. Generate: openssl rand -base64 32
SESSION_SECRET=
# FR-7.3: a demo session and everything it uploaded are purged this many hours
# after it is minted.
SESSION_TTL_HOURS=24

# --- model providers (bound to roles in models.yaml via api_key_env) ---
# Jina AI: embeddings + reranker (EU processing; free tier at https://jina.ai)
JINA_API_KEY=
# Anthropic: classification/extraction (small model) + the Q&A agent loop (frontier model);
# both roles and their pricing are pinned per role in models.yaml.
# Empty => deterministic keyless FakeLlm (plumbing only; real answers need this key).
ANTHROPIC_API_KEY=
# Reserved for the dual-provider fallback router (models.yaml llm.fallback, still unpinned):
# OPENAI_API_KEY=

# --- eval ---
# Safety interlock: the eval runner refuses live provider calls unless enabled.
EVAL_ALLOW_LIVE_PROVIDERS=false
