{
  "name": "@contractix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contractix HTTP API, ingestion worker, and retrieval services",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@contractix/shared": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.4.0",
    "bullmq": "^5.79.2",
    "dotenv": "^17.2.0",
    "drizzle-orm": "catalog:",
    "hono": "^4.12.27",
    "ioredis": "~5.10.1",
    "mammoth": "^1.12.0",
    "mupdf": "^1.28.0",
    "node-html-parser": "^8.0.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "docx": "^9.7.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
