{
  "name": "@contractix/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, canonical types, and helpers shared across Contractix packages",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
