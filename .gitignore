# dependencies
node_modules/

# builds (package build outputs; the sha-pinned golden corpus/dist is committed)
dist/
!corpus/dist/
!corpus/dist/**
*.tsbuildinfo
.vite/

# environment & secrets
.env
.env.*
!.env.example

# runtime data (blob storage, local volumes)
data/

# test artifacts
coverage/

# OS noise
.DS_Store

# per-machine agent settings (.claude/launch.json is shared and committed)
.claude/settings.local.json

# logs
*.log

# eval artifacts: results are per-run, history/cache/baselines are committed
packages/eval/results/

# playwright artifacts
playwright-report/
test-results/
blob-report/
